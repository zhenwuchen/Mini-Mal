# Copy to a protected location such as:
# /etc/mini-mall/production.env
#
# Replace placeholders through your server-side secret manager.
# Never commit the populated file and never use NEXT_PUBLIC_ for secrets.

NODE_ENV=production
DATABASE_URL=file:/var/lib/mini-mall/app.db
AUTH_SECRET=<REQUIRED_STRONG_AUTH_SECRET>
AUTH_TRUST_HOST=true
CRON_SECRET=<REQUIRED_BASE64URL_CRON_SECRET>

# ADMIN_EMAIL, ADMIN_PASSWORD, and ADMIN_NAME are only needed for a
# deliberate first-time seed. Do not include them in a recurring release step.
