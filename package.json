{
  "name": "mini-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "start:production": "node scripts/start-production.mjs",
    "lint": "eslint",
    "test": "node --no-warnings scripts/run-tests.mjs",
    "test:deploy-scripts": "node --no-warnings scripts/run-tests.mjs deploy",
    "test:unit": "node --no-warnings scripts/run-tests.mjs unit",
    "test:storefront-navigation": "node --no-warnings scripts/run-tests.mjs storefront-navigation",
    "test:product-detail-navigation": "node --no-warnings scripts/run-tests.mjs product-detail-navigation",
    "test:ui-integration": "node --no-warnings scripts/run-tests.mjs ui-integration",
    "test:internal-task-auth": "node --no-warnings scripts/run-tests.mjs internal-task-auth",
    "test:internal-order-expiration-handler": "node --no-warnings scripts/run-tests.mjs internal-order-expiration-handler",
    "test:order-expiration": "node --no-warnings scripts/run-tests.mjs order-expiration",
    "_test:deploy-scripts": "node --test tests/deploy-scripts.test.mjs",
    "_test:unit": "tsx --test --test-concurrency=1 tests/test-environment.test.ts tests/image-path.test.ts tests/init-database.test.ts tests/catalog.test.ts tests/product-catalog.test.ts tests/product-pagination.test.ts tests/product-purchase.test.ts tests/product-proxy.test.ts tests/auth-validation.test.ts tests/auth-service.test.ts tests/cart.test.ts tests/cart-action.test.ts tests/cart-line.test.ts tests/quick-add.test.ts tests/header-cart.test.ts tests/header-search.test.ts tests/profile.test.ts tests/order-schema.test.ts tests/address.test.ts tests/address-action.test.ts tests/checkout-action.test.ts tests/payment-action.test.ts tests/order-cancel-action.test.ts tests/order-payment-view.test.ts tests/order-create.test.ts tests/order-query.test.ts tests/order-cancel.test.ts tests/payment.test.ts tests/admin-product.test.ts tests/admin-category.test.ts tests/admin-order.test.ts tests/form-value-preservation.test.ts tests/product-detail-scroll.test.ts",
    "_test:storefront-navigation": "tsx --experimental-test-module-mocks --test --test-concurrency=1 tests/storefront-navigation.test.ts",
    "_test:product-detail-navigation": "tsx --conditions=react-server --test --test-concurrency=1 tests/product-detail-navigation.test.ts",
    "_test:ui-integration": "node --no-warnings scripts/run-ui-tests.mjs",
    "_test:internal-task-auth": "tsx --conditions=react-server --test tests/internal-task-auth.test.ts",
    "_test:internal-order-expiration-handler": "tsx --conditions=react-server --test tests/internal-order-expiration-handler.test.ts",
    "_test:order-expiration": "tsx --conditions=react-server --test tests/order-expiration.test.ts",
    "db:generate": "prisma generate",
    "db:init": "node --no-warnings scripts/init-database.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "config:check:production": "node scripts/validate-production-config.mjs",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^5.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
