DATABASE_URL="file:./dev.db"

# Auth.js requires a high-entropy secret. Generate a separate value for each
# environment; never reuse the local development value in production.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Internal task endpoints use a separate Base64URL credential with at least
# 32 decoded bytes. Generate it independently and keep it server-side only.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# Trust the deployment host when Auth.js cannot infer a trusted host.
# Set this deliberately for the production deployment.
AUTH_TRUST_HOST="true"

# Optional first-time seed configuration for the local catalog and administrator.
# Uncomment these values only when deliberately running `npm run db:seed`.
# Replace every placeholder before use; never commit the populated file.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="replace-with-at-least-12-characters"
# ADMIN_NAME="Mini Mal1 Admin"

